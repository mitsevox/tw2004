# Track B scratch output (extracted / converted assets)
extracted/

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
*.exe

# CI: the Pages export and the pages-history worktree (.github/workflows/build.yml)
/site/
/pages-history/
